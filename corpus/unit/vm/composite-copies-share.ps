% expect-output: true
% expect-output: 7
% Scenario: composite copies share storage.
% Expect: prints "true" then "7".
/a [1 2 3] def
a dup                     % b is a copy of the object a
1 7 put                   % put through b
a a eq =                  % true
a 1 get =                 % 7
