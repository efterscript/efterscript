% expect-output: 65
% expect-output: false
% Scenario: sub-intervals alias their parent.
% Expect: prints "65" then "false".
/s (abcdef) def
/t s 2 3 getinterval def
t 0 65 put
s 2 get =                 % 65
s t eq =                  % false
