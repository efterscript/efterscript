% expect-output: 5.0
% expect-output: 0.0
% expect-output: 4.44
% expect-output: 0.0
% Scenario: an extra face measures with its own metrics. Palatino-Roman
% is resident with the TeX Gyre Pagella widths, so (a) at size 10 is 5,
% where Times-Roman gives 4.44. Widths are rounded to a thousandth
% before printing.
% Expect: 5.0 and 0.0, then 4.44 and 0.0.
/r { 1000 mul round 1000 div } def
/Palatino-Roman findfont 10 scalefont setfont
(a) stringwidth r exch r = =
/Times-Roman findfont 10 scalefont setfont
(a) stringwidth r exch r = =
