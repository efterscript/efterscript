%!PS
% SPDX-FileCopyrightText: 2026 EfterScript contributors
% SPDX-License-Identifier: MIT
% expect-output: invalidfont
% expect-output: false
% Scenario: a Type 1 dictionary the job builds has a matrix and an
% encoding but no CharStrings and no Private, so it carries no glyph
% program; definefont refuses it with invalidfont and registers nothing
% under its key.
% Expect: invalidfont, then false.
{ /F1 << /FontType 1 /FontMatrix [0.001 0 0 0.001 0 0] /Encoding StandardEncoding >>
  definefont } stopped pop
$error /errorname get =
/F1 /Font resourcestatus =
