% SPDX-License-Identifier: MIT
% expect-error: rangecheck
% Scenario: Indexed with a function. A type 4 shading names an Indexed
% colour space and carries a Function: the two exclude each other, so
% shfill raises rangecheck.
<< /ShadingType 4 /ColorSpace [/Indexed /DeviceRGB 1 <ff000000ff00>]
   /Function << /FunctionType 2 /Domain [0 1] /C0 [0] /C1 [1] /N 1 >>
   /DataSource [ 0 0 0 0   0 100 0 1   0 50 80 0.5 ] >> shfill
