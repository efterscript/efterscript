% backend: none
% expect-output: false
% expect-output: false
% expect-output: true
% expect-output: true
% Scenario: without a backend the graphics group is absent from
% systemdict, while page-device setup is always available.
systemdict /fill known =              % false
systemdict /setcolorspace known =     % false
systemdict /setpagedevice known =     % true
systemdict /currentpagedevice known = % true
