%!PS
% SPDX-FileCopyrightText: 2026 EfterScript contributors
% SPDX-License-Identifier: MIT
% oracle: colour
% Scenario: interleaved by sample in DeviceRGB. Each sample of a 4x2
% eight-bit image is a mask byte then red, green, and blue. Under the
% mask's Decode [0 1] a mask byte of 0 paints the sample and 255 keeps
% it off the page; 128 and 1, whose bits are not all alike, count as
% 255. Painted: red and blue in the upper row, cyan and orange in the
% lower; the other four cells show the striped backdrop.
/backdrop {
  0.3 setgray 0 0 1 1 rectfill
  0 setgray 0 0.25 0.75 { 0 0.125 1 rectfill } for
} def
gsave
100 400 translate 200 200 scale
backdrop
/DeviceRGB setcolorspace
%%BeginData: 8 ASCII Lines
<< /ImageType 3 /InterleaveType 1
   /DataDict << /ImageType 1 /Width 4 /Height 2 /BitsPerComponent 8
      /ImageMatrix [4 0 0 -2 0 2] /Decode [0 1 0 1 0 1]
      /DataSource currentfile /ASCIIHexDecode filter >>
   /MaskDict << /ImageType 1 /Width 4 /Height 2 /BitsPerComponent 8
      /ImageMatrix [4 0 0 -2 0 2] /Decode [0 1] >> >> image
00 FF0000  FF 00FF00  00 0000FF  80 FFFF00
FF FF00FF  00 00FFFF  01 FFFFFF  00 FF8000 >
%%EndData
grestore
showpage
