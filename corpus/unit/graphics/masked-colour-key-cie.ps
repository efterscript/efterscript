%!PS
% SPDX-FileCopyrightText: 2026 EfterScript contributors
% SPDX-License-Identifier: MIT
% oracle: colour
% Scenario: a colour key in a converted space. A 2x2 eight-bit type 4
% image in a CIEBasedABC space that does not collapse, MaskColor
% [255 255 255]: the samples are converted to L*a*b*, so the key is
% first turned into a stencil from the raw samples, and the image
% reaches the PDF in the Lab resource with that stencil as its mask.
% The two white samples are kept off the page; the grey and the muted
% red are painted.
/backdrop {
  0.3 setgray 0 0 1 1 rectfill
  0 setgray 0 0.25 0.75 { 0 0.125 1 rectfill } for
} def
gsave
100 400 translate 200 200 scale
backdrop
[/CIEBasedABC <<
  /WhitePoint [0.95 1 1.09]
  /DecodeABC [
    { dup 0.05 le { 12 div } { 0.06 add 1.06 div 2.2 exp } ifelse } bind
    { dup 0.05 le { 12 div } { 0.06 add 1.06 div 2.2 exp } ifelse } bind
    { dup 0.05 le { 12 div } { 0.06 add 1.06 div 2.2 exp } ifelse } bind
  ]
  /MatrixABC [0.41 0.21 0.02  0.36 0.72 0.12  0.18 0.07 0.95]
>>] setcolorspace
<< /ImageType 4 /Width 2 /Height 2 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -2 0 2] /Decode [0 1 0 1 0 1]
   /MaskColor [255 255 255]
   /DataSource <FFFFFF 909090 C06050 FFFFFF> >> image
grestore
showpage
