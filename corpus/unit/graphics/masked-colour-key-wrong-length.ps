% expect-error: rangecheck
% Scenario: a colour key for a three-component image holds three or six
% integers; four is a rangecheck.
/DeviceRGB setcolorspace
<< /ImageType 4 /Width 2 /Height 1 /BitsPerComponent 8
   /ImageMatrix [2 0 0 -1 0 1] /MaskColor [255 255 255 255]
   /DataSource <FFFFFF 800000> >> image
showpage
