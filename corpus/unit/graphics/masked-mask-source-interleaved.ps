% expect-error: typecheck
% Scenario: a mask interleaved by row with the image data may not have
% a data source of its own.
<< /ImageType 3 /InterleaveType 2
   /DataDict << /ImageType 1 /Width 4 /Height 2 /BitsPerComponent 8
      /ImageMatrix [4 0 0 -2 0 2] /DataSource <F0 00112233 F0 44556677> >>
   /MaskDict << /ImageType 1 /Width 4 /Height 2 /BitsPerComponent 1
      /ImageMatrix [4 0 0 -2 0 2] /DataSource <F0F0> >> >> image
showpage
