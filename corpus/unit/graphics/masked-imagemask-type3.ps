% expect-error: rangecheck
% Scenario: imagemask takes type 1 dictionaries only; a well-formed
% type 3 dictionary is a rangecheck.
<< /ImageType 3 /InterleaveType 3
   /DataDict << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 8
      /ImageMatrix [2 0 0 -2 0 2] /DataSource <004080FF> >>
   /MaskDict << /ImageType 1 /Width 2 /Height 2 /BitsPerComponent 1
      /ImageMatrix [2 0 0 -2 0 2] /DataSource <4080> >> >> imagemask
showpage
