% SPDX-License-Identifier: MIT
% expect-output: [612 792]
% expect-output: [300 400]
% expect-output: true
% expect-output: true
% expect-output: true
% Scenario: each setpagedevice merges into the page device; the default
% page size is letter; values survive in global VM across restore.
currentpagedevice /PageSize get ==            % [612 792]
save
<< /PageSize [300 400] /Duplex false >> setpagedevice
<< /InputAttributes << /Priority [0] >> >> setpagedevice
restore
currentpagedevice /PageSize get ==            % [300 400]
currentpagedevice /Duplex known =             % true
currentpagedevice /InputAttributes get /Priority known = % true
currentpagedevice /InputAttributes get gcheck = % true
