% expect-output: 1
% expect-output: 7
% expect-output: false
% expect-output: true
% expect-output: false
% expect-output: true
% Scenario: a pattern instance is made. makepattern returns a read-only
% dictionary carrying the prototype's entries and an Implementation
% entry, whose PatternType is 1 and which setpattern accepts; the
% prototype keeps its seven entries and gains nothing.
/D << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 10 10]
  /XStep 10 /YStep 10 /PaintProc { pop 0 0 5 5 rectfill } >> def
/P D matrix makepattern def
P /PatternType get =
D length =
D /Implementation known =
P /Implementation known =
P wcheck =
P setpattern
currentcolorspace 0 get /Pattern eq =
