%!PS
% SPDX-FileCopyrightText: 2026 EfterScript contributors
% SPDX-License-Identifier: MIT
% backend: none
% divergence: resource-instance-shape
% expect-output: /typecheck
% expect-output: /typecheck
% expect-output: /rangecheck
% expect-output: /rangecheck
% expect-output: /rangecheck
% expect-output: /rangecheck
% expect-output: /typecheck
% expect-output: /typecheck
% expect-output: /typecheck
% expect-output: (ok)
% Scenario: the Pattern category checks an instance's shape. Not a
% dictionary, or one missing an entry, is typecheck; a PatternType other
% than 1, a PaintType outside 1 and 2, a TilingType outside 1 to 3, or
% a zero step is rangecheck; a BBox that is not four numbers, a
% literal PaintProc, or a PatternType that is not an integer is
% typecheck; a well-formed dictionary is accepted.
/try { stopped { $error /errorname get == } { (ok) == } ifelse } def
/base << /PatternType 1 /PaintType 1 /TilingType 1 /BBox [0 0 1 1]
  /XStep 1 /YStep 1 /PaintProc { pop } >> def
/with { base dup length 1 add dict copy dup 4 2 roll put } def
{ /A 5 /Pattern defineresource pop } try
{ /B << /PatternType 1 >> /Pattern defineresource pop } try
{ /C /PatternType 2 with /Pattern defineresource pop } try
{ /D /PaintType 3 with /Pattern defineresource pop } try
{ /E /TilingType 4 with /Pattern defineresource pop } try
{ /F /XStep 0 with /Pattern defineresource pop } try
{ /G /BBox [0 0 1] with /Pattern defineresource pop } try
{ /H /PaintProc [1] with /Pattern defineresource pop } try
{ /I /PatternType (a) with /Pattern defineresource pop } try
{ /J base /Pattern defineresource pop } try
