% expect-output: true
% expect-output: undefinedresult
% expect-output: div
% Scenario: stopped catches an error and $error records it.
% Expect: prints "true", "undefinedresult", "div".
{ 1 0 div } stopped =
$error /errorname get =
$error /command get =
