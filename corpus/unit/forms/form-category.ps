% backend: none
% expect-output: true
% expect-output: 1
% expect-output: true
% expect-output: 1
% expect-output: false
% Scenario: a form is defined and found. A form dictionary defined as
% /Logo /Form defineresource has status true, is returned by
% findresource, has status in the Category category and is enumerated by
% resourceforall, and is gone after undefineresource. The instance is
% painted with once execform exists; this file covers the category.
/Logo << /FormType 1 /BBox [0 0 10 10] /Matrix [1 0 0 1 0 0]
  /PaintProc { pop 0 0 5 5 rectfill } >> /Form defineresource pop
/Logo /Form resourcestatus 3 1 roll pop pop =
/Logo /Form findresource /FormType get =
/Form /Category resourcestatus 3 1 roll pop pop =
0 (Logo) { pop 1 add } 32 string /Form resourceforall =
/Logo /Form undefineresource
/Logo /Form resourcestatus =
