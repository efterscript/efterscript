% expect-output: 10
% expect-output: 0
% Scenario: names end at delimiters, and "/" alone is the empty name.
% Expect: the procedure holds 10 elements: a [ b ] c {d} /e (f) / and /g;
% the empty name has length 0.
{a[b]c{d}/e(f)/ /g%h
} length =     % 10
/ length =     % 0
