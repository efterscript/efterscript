% expect-output: 500
% oracle: skip the operand stack limit is this interpreter's configured one
% Scenario: an unknown key is ignored and a limit keeps its value.
<< /NoSuchKey 1 /MaxOpStack 10 >> setuserparams
currentuserparams /MaxOpStack get =
