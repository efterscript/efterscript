% expect-output: true
% expect-output: 1
% divergence: server-password-default
% Scenario: once the password changes, the old one is refused and the
% new one accepted.
<< /Password 0 /SystemParamsPassword (s3) >> setsystemparams
{ << /Password 0 /MaxFontCache 1 >> setsystemparams } stopped =
<< /Password (s3) /MaxFontCache 1 >> setsystemparams
currentsystemparams /MaxFontCache get =
