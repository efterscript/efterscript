#
# An agent commits on a topic branch only. Agent shells are recognised by
# the CLAUDECODE / CLAUDE_CODE_ENTRYPOINT variables the coding tool
# exports into every command it runs; a human terminal has neither.
# Enable per clone with:
#   git config core.hooksPath .githooks

if [ -n "$CLAUDECODE" ] || [ -n "$CLAUDE_CODE_ENTRYPOINT" ]; then
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    case "$branch" in
        "" | main | master)
            echo "pre-commit: refusing — agents commit on a topic branch, never on main or master (or a detached HEAD)." >&2
            echo "pre-commit: create or switch to a branch, then commit there." >&2
            exit 1
            ;;
    esac
fi
exit 0
