{
  "name": "efterscript",
  "version": "0.0.0",
  "description": "A memory-safe interpreter compatible with the PostScript language, compiled to WebAssembly: a program in, a PDF out, in the browser or Node.js. Vectors stay vectors, text stays text.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efterscript/efterscript.git",
    "directory": "npm/efterscript"
  },
  "homepage": "https://efterscript.github.io/efterscript/",
  "bugs": "https://github.com/efterscript/efterscript/issues",
  "keywords": ["postscript", "pdf", "interpreter", "distillation", "wasm", "webassembly", "converter"],
  "type": "module",
  "main": "./efterscript.js",
  "types": "./efterscript.d.ts",
  "exports": {
    ".": {
      "types": "./efterscript.d.ts",
      "default": "./efterscript.js"
    },
    "./efterscript.wasm": "./efterscript.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "efterscript.js",
    "efterscript.d.ts",
    "efterscript.wasm",
    "README.md",
    "LICENSE",
    "LICENSES",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
